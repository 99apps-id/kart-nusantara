[application]

config/name="Kart Nusantara - Chaos Racing"
config/description="Genre: 3D Arcade Racing, Action, Comedy. Balapan gokart rusuh 8 pemain di jalanan Indonesia dengan drift turbo, power-up chaos, objek interaktif, garage, battle arena, dan replay camera."
